/* Planis — landing page
   Palette ispirata a una mappa di carta invecchiata: fondo "carta",
   inchiostro blu-antracite, accento arancione (lo stesso dell'app)
   e un teal "oceano" come secondo accento per le rotte tratteggiate. */

:root {
  --paper: #f5eedc;
  --paper-alt: #fbf6ea;
  --ink: #22303a;
  --ink-soft: #5a6870;
  --orange: #f18502;
  --orange-dark: #c96c00;
  --teal: #0f7a78;
  --line: #d9c7a0;
  --line-strong: #c2ac7c;
  --radius: 18px;
  --max-w: 1120px;
  --font-head: "Poppins", "Segoe UI", sans-serif;
  --font-body: "Newsreader", Georgia, "Times New Roman", serif;
}

* { box-sizing: border-box; }

html {
  scroll-behavior: smooth;
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  font-size: 18px;
  line-height: 1.65;
  background-image:
    radial-gradient(circle at 1px 1px, rgba(34,48,58,0.06) 1px, transparent 0);
  background-size: 22px 22px;
}

a { color: var(--teal); }
a:focus-visible,
button:focus-visible {
  outline: 3px solid var(--orange);
  outline-offset: 2px;
}

img, svg { max-width: 100%; display: block; }

.wrap {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 28px;
}

/* ---------- Header ---------- */

header.site {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(245, 238, 220, 0.92);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--line);
}

.site-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 16px 0;
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.35rem;
  color: var(--ink);
  text-decoration: none;
  letter-spacing: -0.01em;
}

.logo svg, .logo .logo-img { width: 32px; height: 32px; border-radius: 8px; }

nav.site-nav {
  display: flex;
  align-items: center;
  gap: 26px;
  font-family: var(--font-head);
  font-size: 0.95rem;
  font-weight: 500;
}

nav.site-nav a {
  color: var(--ink-soft);
  text-decoration: none;
  border-bottom: 2px solid transparent;
  padding-bottom: 3px;
  transition: border-color 0.15s ease, color 0.15s ease;
}

nav.site-nav a:hover { color: var(--ink); border-color: var(--orange); }

.btn {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-family: var(--font-head);
  font-weight: 600;
  font-size: 0.95rem;
  text-decoration: none;
  padding: 12px 22px;
  border-radius: 999px;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.btn-primary {
  background: var(--orange);
  color: #fffaf1;
  box-shadow: 0 6px 0 var(--orange-dark);
}
.btn-primary:hover { transform: translateY(-2px); }
.btn-primary:active { transform: translateY(2px); box-shadow: 0 2px 0 var(--orange-dark); }

.btn-ghost {
  border-color: var(--ink);
  color: var(--ink);
}
.btn-ghost:hover { background: var(--ink); color: var(--paper); }

.btn-small { padding: 9px 16px; font-size: 0.85rem; }

/* ---------- Hero ---------- */

.hero {
  padding: 70px 0 40px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 56px;
  align-items: center;
}

.eyebrow-route {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--teal);
  font-family: var(--font-head);
  font-weight: 600;
  font-size: 0.92rem;
  margin-bottom: 18px;
}

.eyebrow-route svg { width: 22px; height: 14px; }

h1.hero-title {
  font-family: var(--font-head);
  font-size: clamp(2.3rem, 4.2vw, 3.3rem);
  line-height: 1.12;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 22px;
  color: var(--ink);
}

.hero-sub {
  font-size: 1.15rem;
  color: var(--ink-soft);
  max-width: 46ch;
  margin: 0 0 34px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-bottom: 30px;
}

.hero-note {
  font-family: var(--font-head);
  font-size: 0.85rem;
  color: var(--ink-soft);
}

.social-row {
  display: flex;
  gap: 12px;
}

.social-btn {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1.5px solid var(--line-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink);
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.social-btn svg { width: 19px; height: 19px; }
.social-btn:hover { background: var(--ink); border-color: var(--ink); color: var(--paper); }

/* ---------- Hero illustration: hand-drawn route ---------- */

.hero-art {
  position: relative;
}

.map-card {
  background: var(--paper-alt);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 26px;
  box-shadow: 0 18px 40px -22px rgba(34,48,58,0.35);
}

.map-card svg { width: 100%; height: auto; }

.stamp {
  position: absolute;
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.03em;
  color: var(--teal);
  border: 2px solid var(--teal);
  border-radius: 50%;
  width: 74px;
  height: 74px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  transform: rotate(-11deg);
  background: var(--paper-alt);
}

.stamp.stamp-2 {
  border-color: var(--orange);
  color: var(--orange-dark);
  transform: rotate(9deg);
}

/* ---------- Sections ---------- */

section { padding: 64px 0; }

.section-head {
  max-width: 60ch;
  margin-bottom: 44px;
}

.section-head .kicker {
  font-family: var(--font-head);
  font-weight: 600;
  color: var(--teal);
  font-size: 0.9rem;
  margin-bottom: 8px;
}

.section-head h2 {
  font-family: var(--font-head);
  font-size: clamp(1.6rem, 3vw, 2.2rem);
  font-weight: 700;
  letter-spacing: -0.01em;
  margin: 0 0 12px;
  color: var(--ink);
}

.section-head p {
  color: var(--ink-soft);
  margin: 0;
}

.route-divider {
  width: 100%;
  height: 20px;
  margin: 0 0 10px;
}

/* Features */

.feature-route {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  position: relative;
}

.feature-route::before {
  content: "";
  position: absolute;
  top: 34px;
  left: 5%;
  right: 5%;
  height: 0;
  border-top: 2.5px dashed var(--line-strong);
}

.feature {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 0 16px;
  position: relative;
}

.feature-badge {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  background: var(--paper-alt);
  border: 2px solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
  position: relative;
  z-index: 2;
}

.feature-badge svg { width: 30px; height: 30px; color: var(--ink); }

.feature h3 {
  font-family: var(--font-head);
  font-size: 1.05rem;
  font-weight: 600;
  margin: 0 0 8px;
}

.feature p {
  color: var(--ink-soft);
  font-size: 0.98rem;
  margin: 0;
}

/* CTA band */

.cta-band {
  background: var(--ink);
  color: var(--paper);
  border-radius: 26px;
  padding: 56px 48px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  flex-wrap: wrap;
}

.cta-band h2 {
  font-family: var(--font-head);
  font-size: clamp(1.5rem, 3vw, 2rem);
  margin: 0 0 8px;
}

.cta-band p {
  color: #c8d2d6;
  margin: 0;
  max-width: 48ch;
}

.cta-band .btn-primary {
  box-shadow: 0 6px 0 var(--orange-dark);
}

/* ---------- Footer ---------- */

footer.site {
  border-top: 1px solid var(--line);
  padding: 40px 0;
  margin-top: 40px;
}

.footer-grid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 18px;
  font-family: var(--font-head);
  font-size: 0.88rem;
  color: var(--ink-soft);
}

.footer-links {
  display: flex;
  gap: 22px;
}

.footer-links a {
  color: var(--ink-soft);
  text-decoration: none;
}
.footer-links a:hover { color: var(--ink); text-decoration: underline; }

/* ---------- Privacy page ---------- */

.legal {
  padding: 50px 0 90px;
}

.legal-header {
  margin-bottom: 40px;
  padding-bottom: 24px;
  border-bottom: 2px dashed var(--line-strong);
}

.legal-header .back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-head);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--teal);
  text-decoration: none;
  margin-bottom: 18px;
}

.legal-header h1 {
  font-family: var(--font-head);
  font-size: clamp(1.8rem, 3.4vw, 2.4rem);
  margin: 0 0 8px;
}

.legal-header .updated {
  font-style: italic;
  color: var(--ink-soft);
  font-size: 0.95rem;
}

.legal-body { max-width: 72ch; }

.legal-body h2 {
  font-family: var(--font-head);
  font-size: 1.25rem;
  font-weight: 600;
  margin: 40px 0 12px;
  color: var(--ink);
}

.legal-body p, .legal-body li { color: var(--ink-soft); }
.legal-body ul { padding-left: 22px; }
.legal-body li { margin-bottom: 6px; }

/* ---------- Responsive ---------- */

@media (max-width: 860px) {
  .hero-grid { grid-template-columns: 1fr; }
  .hero-art { order: -1; }
  .feature-route { grid-template-columns: 1fr 1fr; row-gap: 36px; }
  .feature-route::before { display: none; }
  .cta-band { flex-direction: column; text-align: center; justify-content: center; }
}

@media (max-width: 560px) {
  body { font-size: 16.5px; }
  .site-bar nav.site-nav { display: none; }
  .feature-route { grid-template-columns: 1fr; }
  .wrap { padding: 0 20px; }
  .cta-band { padding: 40px 26px; }
}


/* ---------- Screenshot frame (con placeholder se manca il file) ---------- */

.shot {
  background: var(--ink);
  border-radius: 22px;
  padding: 8px;
  box-shadow: 0 22px 40px -22px rgba(34,48,58,0.5);
  overflow: hidden;
}
.shot img { width: 100%; height: auto; border-radius: 15px; }
.shot.empty {
  aspect-ratio: 16 / 9;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-alt);
  border: 2px dashed var(--line-strong);
  box-shadow: none;
  color: var(--ink-soft);
  font-family: var(--font-head);
  font-size: 0.85rem;
}

/* ---------- Stats strip ---------- */

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 2px dashed var(--line-strong);
  border-bottom: 2px dashed var(--line-strong);
  padding: 26px 0;
}
.stat-item { padding: 0 18px; border-left: 1px solid var(--line); }
.stat-item:first-child { border-left: 0; padding-left: 0; }
.stat-num {
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1.9rem;
  color: var(--orange-dark);
  line-height: 1.2;
}
.stat-txt { color: var(--ink-soft); font-size: 0.95rem; }

/* ---------- Feature rows con screenshot ---------- */

.row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 56px;
  align-items: center;
  padding: 44px 0;
}
.row.flip .row-text { order: 2; }
.row h3 {
  font-family: var(--font-head);
  font-size: 1.5rem;
  margin: 0 0 12px;
  letter-spacing: -0.01em;
}
.row p { color: var(--ink-soft); margin: 0 0 16px; max-width: 46ch; }
.tags { display: flex; flex-wrap: wrap; gap: 8px; }
.tags span {
  font-family: var(--font-head);
  font-size: 0.8rem;
  font-weight: 500;
  border: 1.5px solid var(--line-strong);
  border-radius: 999px;
  padding: 4px 12px;
  color: var(--ink);
}

/* ---------- FAQ ---------- */

.faq { max-width: 760px; }
.faq details { border-bottom: 1px solid var(--line-strong); padding: 18px 0; }
.faq summary {
  font-family: var(--font-head);
  font-weight: 600;
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  gap: 16px;
}
.faq summary::-webkit-details-marker { display: none; }
.faq summary::after { content: "+"; color: var(--orange-dark); font-size: 1.3rem; line-height: 1; }
.faq details[open] summary::after { content: "\2212"; }
.faq details p { color: var(--ink-soft); margin: 12px 0 0; }

.follow { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
.follow p { margin: 0; font-family: var(--font-head); font-weight: 600; }

@media (max-width: 860px) {
  .row { grid-template-columns: 1fr; gap: 26px; padding: 30px 0; }
  .row.flip .row-text { order: 0; }
  .stats { grid-template-columns: 1fr 1fr; row-gap: 22px; }
  .stat-item:nth-child(3) { border-left: 0; padding-left: 0; }
}
